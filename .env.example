DATABASE_URL="postgresql://catequese:aparecida@localhost:5432/catequesedb?schema=public"
JWT_SECRET="troque-este-segredo"
PORT=3333

# Supabase Storage (fotos de perfil). Secret key (sb_secret_...) ou service_role, em Project Settings > API Keys
SUPABASE_URL="https://<projeto>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_AVATAR_BUCKET="avatars"
SUPABASE_RITES_BUCKET="rites"
# Documentos das inscrições (RG, certidões): crie este bucket como PRIVADO
SUPABASE_REGISTRATIONS_BUCKET="registrations"
# Proxies na frente da API (o limite de envios da inscrição usa o IP real)
TRUST_PROXY_HOPS=1
