// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDINATOR
  MEMBER
}

model Catechist {
  id       String   @id @default(uuid())
  name     String
  nickname String   @default("")
  role     Role     @default(MEMBER)
  birthday DateTime @db.Date
  phone    String
  address  String

  hasReceivedBaptism      Boolean
  hasReceivedEucharist    Boolean
  hasReceivedConfirmation Boolean
  hasReceivedMarriage     Boolean

  email         String @unique
  password_hash String

  classrooms           Classroom[]
  formationAttendances FormationAttendance[]

  // Preenchido quando o catequista vai para o arquivo
  archivedAt DateTime?

  @@map("catechists")
}

model Catechizing {
  id                      String   @id @default(uuid())
  name                    String
  birthday                DateTime @db.Date
  address                 String
  personWithSpecialNeeds  Boolean
  specialNeedsDescription String?
  releasedToGoAwayAlone   Boolean  @default(false)

  // Só preenchidos em turmas de adultos
  maritalStatus    String?
  livesWithPartner Boolean?

  hasReceivedBaptism   Boolean
  hasReceivedEucharist Boolean
  hasReceivedMarriage  Boolean @default(false)

  parents Parent[]

  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId String

  // Preenchido quando o catequizando vai para o arquivo
  archivedAt DateTime?

  @@map("catechizings")
}

model Parent {
  id      String @id @default(uuid())
  name    String
  phone   String
  kinship String

  catechizing   Catechizing @relation(fields: [catechizingId], references: [id], onDelete: Cascade)
  catechizingId String

  @@map("parents")
}

model Classroom {
  id        String @id @default(uuid())
  location  String
  segment   String
  startedAt Int

  // Link de convite do grupo de WhatsApp da turma (chat.whatsapp.com/...)
  whatsappGroupLink String?

  catechists   Catechist[]
  catechizings Catechizing[]

  // Preenchido quando a turma vai para o arquivo
  archivedAt DateTime?

  @@map("classrooms")
}

model Formation {
  id    String   @id @default(uuid())
  theme String
  date  DateTime @db.Date

  attendances FormationAttendance[]

  @@map("formations")
}

model FormationAttendance {
  id        String  @id @default(uuid())
  isPresent Boolean

  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  formationId String

  catechist   Catechist @relation(fields: [catechistId], references: [id], onDelete: Cascade)
  catechistId String

  @@unique([formationId, catechistId])
  @@map("formation_attendances")
}
