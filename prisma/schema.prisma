// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDINATOR
  MEMBER
}

model Catechist {
  id       String   @id @default(uuid())
  name     String
  nickname String   @default("")
  role     Role     @default(MEMBER)
  birthday DateTime @db.Date
  phone    String
  address  String

  hasReceivedBaptism      Boolean
  hasReceivedEucharist    Boolean
  hasReceivedConfirmation Boolean
  hasReceivedMarriage     Boolean

  email         String @unique
  password_hash String

  classrooms           Classroom[]
  formationAttendances FormationAttendance[]

  // Preenchido quando o catequista vai para o arquivo
  archivedAt DateTime?

  // URL pública da foto de perfil no Supabase Storage
  avatarUrl String?

  @@map("catechists")
}

model Catechizing {
  id                      String   @id @default(uuid())
  name                    String
  birthday                DateTime @db.Date
  address                 String
  personWithSpecialNeeds  Boolean
  specialNeedsDescription String?
  releasedToGoAwayAlone   Boolean  @default(false)

  // Só preenchidos em turmas de adultos
  maritalStatus    String?
  livesWithPartner Boolean?

  hasReceivedBaptism   Boolean
  hasReceivedEucharist Boolean
  hasReceivedMarriage  Boolean @default(false)

  parents Parent[]

  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId String

  meetingAttendances MeetingAttendance[]

  // Preenchido quando o catequizando vai para o arquivo
  archivedAt DateTime?

  @@map("catechizings")
}

model Parent {
  id      String @id @default(uuid())
  name    String
  phone   String
  kinship String

  catechizing   Catechizing @relation(fields: [catechizingId], references: [id], onDelete: Cascade)
  catechizingId String

  @@map("parents")
}

model Classroom {
  id        String @id @default(uuid())
  location  String
  segment   String
  startedAt Int

  // Link de convite do grupo de WhatsApp da turma (chat.whatsapp.com/...)
  whatsappGroupLink String?

  catechists   Catechist[]
  catechizings Catechizing[]
  meetings     Meeting[]

  // Preenchido quando a turma vai para o arquivo
  archivedAt DateTime?

  @@map("classrooms")
}

model Formation {
  id         String   @id @default(uuid())
  theme      String
  // Quem conduziu a formação (pode ser alguém de fora, como o padre)
  instructor String?
  date       DateTime @db.Date

  attendances FormationAttendance[]

  @@map("formations")
}

model FormationAttendance {
  id        String  @id @default(uuid())
  isPresent Boolean

  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  formationId String

  catechist   Catechist @relation(fields: [catechistId], references: [id], onDelete: Cascade)
  catechistId String

  @@unique([formationId, catechistId])
  @@map("formation_attendances")
}

// Tema de encontro do itinerário (Pré-Eucaristia, Eucaristia, Crisma, Adultos),
// editável pela coordenação
model MeetingTheme {
  id        String @id @default(uuid())
  itinerary String
  // Tempo/fase do itinerário em que o tema aparece
  phase     String
  name      String
  // Ordem dentro do itinerário
  position  Int

  meetings Meeting[]

  // Temas excluídos somem da escolha, mas continuam no histórico das chamadas
  archivedAt DateTime?

  @@index([itinerary])
  @@map("meeting_themes")
}

// Encontro de uma turma com a chamada dos catequizandos (um ou mais temas)
model Meeting {
  id   String   @id @default(uuid())
  date DateTime @db.Date

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId String

  themes      MeetingTheme[]
  attendances MeetingAttendance[]

  @@index([classroomId])
  @@map("meetings")
}

model MeetingAttendance {
  id        String  @id @default(uuid())
  isPresent Boolean

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String

  catechizing   Catechizing @relation(fields: [catechizingId], references: [id], onDelete: Cascade)
  catechizingId String

  @@unique([meetingId, catechizingId])
  @@map("meeting_attendances")
}
