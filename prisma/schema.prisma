// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDINATOR
  MEMBER
}

model Catechist {
  id       String   @id @default(uuid())
  name     String
  nickname String   @default("")
  role     Role     @default(MEMBER)
  birthday DateTime @db.Date
  phone    String
  address  String

  hasReceivedBaptism      Boolean
  hasReceivedEucharist    Boolean
  hasReceivedConfirmation Boolean
  hasReceivedMarriage     Boolean

  email         String @unique
  password_hash String

  classrooms            Classroom[]
  formationAttendances  FormationAttendance[]
  expensesCreated       Expense[]
  entriesCreated        CashEntry[]
  registrationsReviewed Registration[]

  // Preenchido quando o catequista vai para o arquivo
  archivedAt DateTime?

  // URL pública da foto de perfil no Supabase Storage
  avatarUrl String?

  @@map("catechists")
}

model Catechizing {
  id                      String   @id @default(uuid())
  name                    String
  birthday                DateTime @db.Date
  address                 String
  personWithSpecialNeeds  Boolean
  specialNeedsDescription String?
  releasedToGoAwayAlone   Boolean  @default(false)

  // Só preenchidos em turmas de adultos
  maritalStatus    String?
  livesWithPartner Boolean?

  hasReceivedBaptism   Boolean
  hasReceivedEucharist Boolean
  hasReceivedMarriage  Boolean @default(false)

  // Vêm da ficha de inscrição
  shirtSize          String?
  foodRestriction    String?
  // Quem pode buscar o catequizando quando ele não vai embora sozinho
  pickupAuthorizedBy String?

  parents Parent[]

  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId String

  meetingAttendances MeetingAttendance[]
  carnePayments      CashEntry[]
  // Inscrição pública de onde ele veio (com os documentos enviados)
  registration       Registration?

  // Preenchido quando o catequizando vai para o arquivo
  archivedAt DateTime?

  @@map("catechizings")
}

model Parent {
  id      String @id @default(uuid())
  name    String
  phone   String
  kinship String

  catechizing   Catechizing @relation(fields: [catechizingId], references: [id], onDelete: Cascade)
  catechizingId String

  @@map("parents")
}

model Classroom {
  id        String @id @default(uuid())
  location  String
  segment   String
  startedAt Int

  // Link de convite do grupo de WhatsApp da turma (chat.whatsapp.com/...)
  whatsappGroupLink String?

  catechists   Catechist[]
  catechizings Catechizing[]
  meetings     Meeting[]

  // Preenchido quando a turma vai para o arquivo
  archivedAt DateTime?

  @@map("classrooms")
}

model Formation {
  id         String   @id @default(uuid())
  theme      String
  // Quem conduziu a formação (pode ser alguém de fora, como o padre)
  instructor String?
  date       DateTime @db.Date

  attendances FormationAttendance[]

  @@map("formations")
}

model FormationAttendance {
  id        String  @id @default(uuid())
  isPresent Boolean

  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  formationId String

  catechist   Catechist @relation(fields: [catechistId], references: [id], onDelete: Cascade)
  catechistId String

  @@unique([formationId, catechistId])
  @@map("formation_attendances")
}

// Tema de encontro do itinerário (Pré-Eucaristia, Eucaristia, Crisma, Adultos),
// editável pela coordenação
model MeetingTheme {
  id        String @id @default(uuid())
  itinerary String
  // Tempo/fase do itinerário em que o tema aparece
  phase     String
  name      String
  // Ordem dentro do itinerário
  position  Int

  meetings Meeting[]

  // Temas excluídos somem da escolha, mas continuam no histórico das chamadas
  archivedAt DateTime?

  @@index([itinerary])
  @@map("meeting_themes")
}

// Encontro de uma turma com a chamada dos catequizandos (um ou mais temas)
model Meeting {
  id   String   @id @default(uuid())
  date DateTime @db.Date

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId String

  themes      MeetingTheme[]
  attendances MeetingAttendance[]

  @@index([classroomId])
  @@map("meetings")
}

model MeetingAttendance {
  id        String  @id @default(uuid())
  isPresent Boolean

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String

  catechizing   Catechizing @relation(fields: [catechizingId], references: [id], onDelete: Cascade)
  catechizingId String

  @@unique([meetingId, catechizingId])
  @@map("meeting_attendances")
}

enum PaymentMethod {
  PIX
  CASH
  CARD
}

enum EntrySource {
  // Ajuda dos catequistas ao caixa
  COLLABORATION
  // Pagamento do carnê de um catequizando
  CARNE
  DONATION
  // Valor pago pela paróquia
  PARISH
}

// Saída do caixa: o que foi gasto e com o quê
model Expense {
  id            String        @id @default(uuid())
  // Destinação: com o que foi gasto
  description   String
  // Valores em centavos, para não ter erro de arredondamento
  amountCents   Int
  date          DateTime      @db.Date
  paymentMethod PaymentMethod

  // Quem registrou (fica vazio se o catequista for apagado)
  createdBy   Catechist? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime   @default(now())

  @@index([date])
  @@map("expenses")
}

// Entrada no caixa. Pagamentos do carnê são entradas de origem CARNE
// ligadas ao catequizando
model CashEntry {
  id            String        @id @default(uuid())
  source        EntrySource
  amountCents   Int
  date          DateTime      @db.Date
  paymentMethod PaymentMethod
  // Quem pagou/doou/colaborou (obrigatório no carnê)
  payerName     String?
  description   String?

  // Só no carnê. O pagamento continua no caixa se o catequizando for apagado
  catechizing   Catechizing? @relation(fields: [catechizingId], references: [id], onDelete: SetNull)
  catechizingId String?

  createdBy   Catechist? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime   @default(now())

  @@index([date])
  @@index([catechizingId])
  @@map("cash_entries")
}

// Rito da catequese (ex.: apresentação, entrega do Creio) com o PDF do roteiro
model Rite {
  id          String     @id @default(uuid())
  name        String
  description String?
  // PDFs do rito (um rito pode ter mais de um, ex.: roteiro e folder)
  files       RiteFile[]

  createdAt DateTime @default(now())

  @@map("rites")
}

// PDF anexado a um rito. A URL é pública: no Supabase Storage ou, nos ritos
// que já existiam, um caminho do próprio app (/ritos/...)
model RiteFile {
  id   String @id @default(uuid())
  // Nome original do arquivo
  name String
  url  String

  rite   Rite   @relation(fields: [riteId], references: [id], onDelete: Cascade)
  riteId String

  createdAt DateTime @default(now())

  @@index([riteId])
  @@map("rite_files")
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationDocumentKind {
  // Certidão de nascimento ou RG de quem vai fazer a catequese
  PERSON_ID
  // RG/CNH do responsável (só quem é menor de idade)
  GUARDIAN_ID
  PROOF_OF_RESIDENCE
  BAPTISM
  EUCHARIST
  // Certidão de casamento no religioso (só adultos)
  MARRIAGE
}

// Inscrição enviada pelo formulário público (sem login). A coordenação confere
// e, ao aprovar, ela vira um catequizando na turma escolhida
model Registration {
  id String @id @default(uuid())

  // Etapa escolhida: PRE_EUCARISTIA, EUCARISTIA, CRISMA ou ADULTOS
  segment String
  status  RegistrationStatus @default(PENDING)

  name                    String
  birthday                DateTime @db.Date
  address                 String
  personWithSpecialNeeds  Boolean
  specialNeedsDescription String?
  foodRestriction         String?
  releasedToGoAwayAlone   Boolean  @default(false)
  pickupAuthorizedBy      String?
  shirtSize               String?

  hasReceivedBaptism   Boolean
  hasReceivedEucharist Boolean
  hasReceivedMarriage  Boolean @default(false)

  // Só adultos
  maritalStatus    String?
  livesWithPartner Boolean?

  // [{ name, phone, kinship }]; para adultos, o próprio inscrito
  parents Json

  files RegistrationFile[]

  // Resposta da coordenação
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      Catechist? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById    String?

  // Preenchido ao aprovar
  catechizing   Catechizing? @relation(fields: [catechizingId], references: [id], onDelete: SetNull)
  catechizingId String?      @unique

  // Quando a família marcou que leu e concorda com o termo de compromisso
  termsAcceptedAt DateTime

  // Hash do IP de quem enviou (para rastrear abuso sem guardar o IP)
  submitterHash String?
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
  @@index([name, birthday])
  @@map("registrations")
}

// Documento enviado na inscrição. Fica num bucket privado do Supabase: o
// caminho nunca sai da API, a coordenação abre por link temporário
model RegistrationFile {
  id           String                   @id @default(uuid())
  kind         RegistrationDocumentKind
  // Caminho dentro do bucket
  storagePath  String
  // Nome original (só para exibir)
  originalName String
  mimeType     String
  sizeBytes    Int

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String

  createdAt DateTime @default(now())

  @@unique([registrationId, kind])
  @@map("registration_files")
}

// Liga e desliga o formulário público de inscrição. Uma linha só (id 1);
// sem linha, as inscrições estão fechadas
model RegistrationSettings {
  id           Int      @id @default(1)
  isOpen       Boolean  @default(false)
  // Etapas que recebem inscrição (valores de RegistrationSegment). Só valem
  // com isOpen ligado; por padrão todas
  openSegments String[] @default(["PRE_EUCARISTIA", "EUCARISTIA", "CRISMA", "ADULTOS"])
  updatedAt    DateTime @updatedAt

  @@map("registration_settings")
}
